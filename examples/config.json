{
  "sbx": {
    "template": "my-sbx:latest",
    "clone_base": "~/src",
    "worktree_base": "~/worktrees",
    "mounts": [
      "~/dotfiles:ro"
    ],
    "kits": [
      "./my-kit/",
      "ghcr.io/myorg/my-kit:1.0"
    ],
    "plugins": [
      {
        "source": "~/claude-plugins",
        "plugins": ["my-plugin"]
      }
    ],
    "post_create_cmds": [
      ["~/src/claude-sbx/examples/sbx-setup.sh"]
    ]
  }
}

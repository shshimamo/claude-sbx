{
  "sbx": {
    "template": "my-sbx:latest",
    "clone_base": "~/src",
    "worktree_base": "~/worktrees",
    "mounts": [
      "~/dotfiles:ro"
    ],
    "kits": [
      "./my-kit/",
      "ghcr.io/myorg/my-kit:1.0"
    ],
    "plugins": [
      {
        "source": "~/claude-plugins",
        "plugins": ["my-plugin"]
      }
    ],
    "post_create_cmds": [
      ["~/.claude-sbx/setup_hooks.sh"]
    ]
  },
  "notifications": [
    { "pattern": "Do you want to allow Claude to", "title": "許可待ち" }
  ],
  "hook_notifications": {
    "events": ["Stop", "PermissionRequest", "AskUserQuestion"]
  }
}
